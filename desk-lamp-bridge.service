[Unit]
Description=Xiaomi Desk Lamp Pro - Loxone Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=automation
WorkingDirectory=/opt/desk-lamp-bridge
EnvironmentFile=/opt/desk-lamp-bridge/lamp.env
ExecStart=/opt/desk-lamp-bridge/.venv/bin/python /opt/desk-lamp-bridge/bridge.py

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
